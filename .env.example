# ==============================================================
# API Keys & Configuration Template
# Copy this file to `.env` and fill in the values you want to use.
# ==============================================================

# OpenAI API Key (Required for langchain-openai models)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Key (Required if using langchain-google-genai)
GOOGLE_API_KEY=your_gemini_api_key_here

# Optional: LangSmith Tracing & Observability
# Enables visual graph execution tracking at smith.langchain.com
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT="langchain-langgraph-explained"
